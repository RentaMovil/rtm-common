<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.rentamovil</groupId>
	<artifactId>rtm-common</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>rtm-common</name>
	<description>Shared infrastructure code (error handling, request logging) for RentaMovil's Spring Boot microservices</description>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Kept in sync with the Spring Boot version used by the consuming microservices -->
		<spring-boot.version>4.1.1</spring-boot.version>
	</properties>

	<!-- BOM import only, for consistent versions with the consuming services. This is a plain
	     library (packaging=jar), not a Spring Boot application: no spring-boot-maven-plugin here. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- provided: every consuming service already brings its own spring-boot-starter-webmvc.
		     rtm-common must not drag a second copy along as a transitive dependency. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- For DataIntegrityViolationException (org.springframework.dao). Every current consumer
		     already brings this transitively via spring-boot-starter-data-jpa. -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-tx</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- Pinned to the same version spring-boot-starter-parent manages for the consuming
				     services (3.16.0, the default Maven would otherwise resolve, fails to compile
				     under JDK 27 here: EndPosTable ExceptionInInitializerError). -->
				<version>3.15.0</version>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Published to GitHub Packages (Maven registry), org RentaMovil. Consuming services add
	     this same URL as a <repository> to resolve it, authenticating with a GitHub PAT
	     (read:packages scope) in their settings.xml / CI secrets. -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub RentaMovil Packages</name>
			<url>https://maven.pkg.github.com/RentaMovil/rtm-common</url>
		</repository>
	</distributionManagement>
</project>
